# Build stage: use Maven and Java 17 to compile the Spring Boot backend
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /app

# Copy Maven project file first
COPY pom.xml .

# Copy source code
COPY src ./src

# Build the Spring Boot application without running tests
RUN mvn clean package -DskipTests

# Runtime stage: use Java 17 runtime only
FROM eclipse-temurin:17-jre

WORKDIR /app

# Copy the built JAR file from the build stage
COPY --from=build /app/target/*.jar app.jar

# Render provides the PORT environment variable
EXPOSE 8080

#Start the app and force Spring Boot to use Render's PORT value
CMD ["sh", "-c", "java -Dserver.port=${PORT:-8080} -jar app.jar"]
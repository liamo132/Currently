# Copy to a local environment file and load securely per shell/session.
POSTGRES_DB=currently_db
POSTGRES_USER=currently_user
POSTGRES_PASSWORD=replace_with_real_password
POSTGRES_URL=jdbc:postgresql://localhost:5432/currently_db
POSTGRES_SSLMODE=disable
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=replace_with_base64_32byte_plus_secret
JWT_EXPIRATION_MS=3600000
APP_DATA_ENCRYPTION_KEY=replace_with_base64_32byte_key
APP_DATA_HASH_KEY=replace_with_base64_32byte_or_longer_key
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
